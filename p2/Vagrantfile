SERVER_NAME = 'gmarquisS'
SERVER_IP   = '192.168.56.110'

Vagrant.configure('2') do |config|
  config.vm.box = 'bento/debian-13'
  config.vm.synced_folder '.', '/vagrant', disabled: true
  config.vm.provider :virtualbox do |vb|
    vb.memory = 2048
    vb.cpus   = 2
  end

  config.vm.provider :libvirt do |lv, override|
    override.vm.box = 'debian/trixie64'
    lv.memory = 2048
    lv.cpus   = 2
  end
  config.vm.define SERVER_NAME do |node|
    node.vm.hostname = SERVER_NAME
    node.vm.network 'private_network', ip: SERVER_IP

    node.vm.provider :virtualbox do |vb|
      vb.name = SERVER_NAME
    end
    node.vm.provider :libvirt do |lv|
      lv.default_prefix = ''
    end
    node.vm.provision 'file',
      source: 'confs',
      destination: '/tmp/confs'

    node.vm.provision 'shell',
      path: 'scripts/server.sh',
      args: [SERVER_IP]
  end
end
