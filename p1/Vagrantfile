require 'securerandom'

TOKEN_FILE = File.expand_path('.k3s_token', __dir__)
File.write(TOKEN_FILE, SecureRandom.hex(32)) unless File.exist?(TOKEN_FILE)
K3S_TOKEN = File.read(TOKEN_FILE).strip

SERVER_NAME = 'gmarquisS'
SERVER_IP   = '192.168.56.110'
WORKER_NAME = 'gmarquisSW'
WORKER_IP   = '192.168.56.111'

Vagrant.configure('2') do |config|
  config.vm.box = 'bento/debian-13'
  config.vm.synced_folder '.', '/vagrant', disabled: true

  config.vm.provider :virtualbox do |vb|
    vb.memory = 1024
    vb.cpus   = 1
  end

  config.vm.provider :libvirt do |lv, override|
    override.vm.box = 'debian/trixie64'
    lv.memory = 1024
    lv.cpus   = 1
  end

  config.vm.define SERVER_NAME do |node|
    node.vm.hostname = SERVER_NAME
    node.vm.network 'private_network', ip: SERVER_IP

    node.vm.provider :virtualbox do |vb|
      vb.name = SERVER_NAME
    end
    node.vm.provider :libvirt do |lv|
      lv.default_prefix = ''
    end

    node.vm.provision 'shell',
      path: 'scripts/server.sh',
      args: [SERVER_IP, K3S_TOKEN]
  end

  config.vm.define WORKER_NAME do |node|
    node.vm.hostname = WORKER_NAME
    node.vm.network 'private_network', ip: WORKER_IP

    node.vm.provider :virtualbox do |vb|
      vb.name = WORKER_NAME
    end
    node.vm.provider :libvirt do |lv|
      lv.default_prefix = ''
    end

    node.vm.provision 'shell',
      path: 'scripts/worker.sh',
      args: [WORKER_IP, K3S_TOKEN, "https://#{SERVER_IP}:6443"]
  end
end
